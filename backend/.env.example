# =============================================================================
# Multi Kreasi Printing — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# NEVER commit the real .env file to git.
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=3000

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-db-password-here
DB_NAME=mkprinting
DB_POOL_MIN=5
DB_POOL_MAX=20

# Prisma CLI still uses DATABASE_URL for migrations
# Heroku Postgres provides this automatically as a config var
DATABASE_URL="postgresql://postgres:your-db-password-here@localhost:5432/mkprinting?schema=public"

# --- Redis ---
# For local dev, use individual vars. On Heroku, REDIS_URL is set automatically.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://h:password@host:port  (set by Heroku Key-Value Store add-on)
# REDIS_TLS=true  (set to 'true' if your Redis requires TLS, e.g. Heroku)

# --- JWT Authentication ---
JWT_SECRET=generate-a-random-64-char-string-here
JWT_REFRESH_SECRET=generate-a-different-random-64-char-string-here

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Multi Kreasi Printing <noreply@multikreasi.com>

# --- Object Storage (Cloudflare R2) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=multikreasi-storage
R2_PUBLIC_URL=https://storage.multikreasi.com
MAX_FILE_SIZE=104857600

# --- Rate Limiting ---
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
